<?xml version="1.0"?>
<sdf version="1.10">
  <world name="airmouse_physics">
    <gravity>0 0 -9.81</gravity>
    <physics name="airmouse_physics_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <model name="airmouse" canonical_link="base_link">
      <pose>0 0 1.5 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.196</mass>
          <inertia><ixx>0.018</ixx><iyy>0.018</iyy><izz>0.032</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="body_collision"><geometry><box><size>0.22 0.22 0.08</size></box></geometry></collision>
        <visual name="body_visual"><geometry><box><size>0.22 0.22 0.08</size></box></geometry><material><ambient>0.12 0.25 0.75 1</ambient><diffuse>0.12 0.25 0.75 1</diffuse></material></visual>
        <visual name="arm_x_visual"><pose>0 0 0 0 0 0.785398</pose><geometry><box><size>0.92 0.045 0.035</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="arm_y_visual"><pose>0 0 0 0 0 -0.785398</pose><geometry><box><size>0.92 0.045 0.035</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>

      <!-- Rotor links sit at the four X-frame tips; their tiny masses are included in the stated total mass. -->
      <link name="rotor_0"><pose>0.282843 0.282843 0 0 0 0</pose><inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link>
      <link name="rotor_1"><pose>-0.282843 0.282843 0 0 0 0</pose><inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link>
      <link name="rotor_2"><pose>-0.282843 -0.282843 0 0 0 0</pose><inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material></visual></link>
      <link name="rotor_3"><pose>0.282843 -0.282843 0 0 0 0</pose><inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material></visual></link>
      <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><pose>0.282843 0.282843 0 0 0 0</pose><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><pose>-0.282843 0.282843 0 0 0 0</pose><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><pose>-0.282843 -0.282843 0 0 0 0</pose><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><pose>0.282843 -0.282843 0 0 0 0</pose><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

      <!-- Diagnostic-only, model-level joint telemetry. No physics commands are applied. -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/airmouse/diagnostic/joint_state</topic>
        <update_rate>200</update_rate>
        <joint_name>rotor_0_joint</joint_name>
        <joint_name>rotor_1_joint</joint_name>
        <joint_name>rotor_2_joint</joint_name>
        <joint_name>rotor_3_joint</joint_name>
      </plugin>

      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>airmouse</robotNamespace><jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>800</maxRotVelocity><motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>gazebo/command/motor_speed</commandSubTopic><actuator_number>0</actuator_number><rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>airmouse</robotNamespace><jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>800</maxRotVelocity><motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>gazebo/command/motor_speed</commandSubTopic><actuator_number>1</actuator_number><rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>airmouse</robotNamespace><jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>800</maxRotVelocity><motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>gazebo/command/motor_speed</commandSubTopic><actuator_number>2</actuator_number><rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>airmouse</robotNamespace><jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>800</maxRotVelocity><motorConstant>8.54858e-06</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>gazebo/command/motor_speed</commandSubTopic><actuator_number>3</actuator_number><rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
    </model>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.2 -1</direction></light>
  </world>
</sdf>
